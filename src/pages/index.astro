---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { loadCatalog, loadStatus } from '../lib/data';
import { base, formatNumber } from '../lib/format';
const catalog = await loadCatalog();
const status = await loadStatus();
const types = [...new Set(catalog.rules.flatMap(rule => rule.variants.flatMap(v => v.types)))].sort();
const formats = [...new Set(catalog.rules.flatMap(rule => rule.variants.flatMap(v => v.artifacts.map(a => a.extension))))].sort();
---
<Layout title="规则目录">
  <div class="page-heading"><div><h1>规则目录</h1><p>找到规则，选好客户端，直接复制订阅地址。</p></div><span class="backup-summary">{formatNumber(status.artifactCount)} 个文件已备份</span></div>
  <section class="catalog" aria-label="搜索和筛选规则" data-search-url={`${base}/search-index.json?v=${encodeURIComponent(status.lastSuccessfulSyncAt)}`} data-base={base}>
    <form id="search-form" role="search" class="search-form"><label class="sr-only" for="query">搜索规则名称、说明或来源</label><Icon name="search" size={24}/><input id="query" name="q" type="search" autocomplete="off" placeholder="搜索规则名称、中文名、说明或来源…" /><kbd aria-hidden="true">/</kbd><button class="button primary" type="submit">搜索规则</button></form>
    <div class="filter-bar"><div class="client-filters" role="group" aria-label="客户端"><button type="button" data-client="" aria-pressed="true">全部<span>{formatNumber(status.activeRuleCount)}</span></button>{status.clients.map(client => <button type="button" data-client={client.name} aria-pressed="false"><span class={`client-dot ${client.name.toLowerCase()}`}></span>{client.name}<span>{formatNumber(client.count)}</span></button>)}</div><div class="filter-fields"><div class="type-filter"><label for="rule-type">规则类型</label><select id="rule-type" aria-label="规则类型"><option value="">全部类型</option>{types.map(type => <option value={type}>{type}</option>)}</select></div><div class="type-filter"><label for="file-format">文件格式</label><select id="file-format" aria-label="文件格式"><option value="">全部格式</option>{formats.map(format => <option value={format}>{format.toUpperCase()}</option>)}</select></div></div></div>
    <div class="results-toolbar"><p id="result-count" role="status" aria-live="polite">正在加载 {formatNumber(status.activeRuleCount)} 个规则…</p><div class="result-options"><label class="archive-toggle"><input id="include-archived" type="checkbox"/>包含下架规则</label><label for="sort">排序</label><select id="sort" aria-label="排序"><option value="updated">源站更新 · 从新到旧</option><option value="backup">备份文件变更 · 从新到旧</option><option value="name">规则名称 · A–Z</option></select></div></div>
    <div class="list-panel"><div class="rule-table" role="table" aria-label="规则搜索结果"><div class="table-head" role="row"><span role="columnheader">规则名称</span><span role="columnheader">订阅文件 / 格式</span><span role="columnheader">规则条数</span><span role="columnheader">源站规则更新</span><span role="columnheader" class="align-right">操作</span></div><div id="results" role="rowgroup" aria-busy="true"><div class="loading-state">正在读取备份目录…</div></div></div>
    <div id="empty" class="empty-state" hidden><Icon name="search" size={36}/><h2>没有找到符合条件的规则</h2><p>试试英文名或更短的关键词，也可以清除筛选条件。</p><button id="reset" class="button" type="button">清除筛选</button></div>
    <div id="load-error" class="empty-state" hidden><h2>规则目录暂时无法加载</h2><p>请检查网络后重试。备份文件仍可从 GitHub 仓库获取。</p><button id="retry" class="button" type="button">重新加载</button></div>
    <nav id="pagination" class="pagination" aria-label="搜索结果分页"><span id="page-info"></span><div><button id="previous" class="button" type="button">上一页</button><button id="next" class="button" type="button">下一页 <Icon name="arrow" size={16}/></button></div></nav></div>
    <noscript><p class="inline-note">搜索需要启用 JavaScript。你也可以前往 <a href={`${base}/updates/`}>同步记录</a> 或 <a href="https://github.com/ClaraCora/magicrule-backup/tree/data/current/rules">仓库规则目录</a> 查找备份。</p></noscript>
  </section>
  <p class="catalog-note"><Icon name="check" size={16}/><span>{formatNumber(status.clientRuleCount)} 份客户端规则记录已备份。相同规则合并展示，下载文件来自本仓库。</span></p>
</Layout>
<script>
  import '../scripts/catalog';
</script>
